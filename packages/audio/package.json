{
  "name": "@allem-xr/audio",
  "version": "0.1.0",
  "description": "Spatial audio, audio zones, and HRTF rendering for React XR.",
  "license": "MIT",
  "author": "Ahmed Allem",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/three": "^0.170.0",
    "react": "^19.0.0",
    "three": "^0.170.0",
    "@react-three/fiber": "^9.0.0",
    "@allem-xr/core": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@react-three/fiber": ">=8.0.0",
    "three": ">=0.160.0",
    "@allem-xr/core": ">=0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/allem-xr.git",
    "directory": "packages/audio"
  },
  "keywords": [
    "allem-xr",
    "react",
    "spatial-audio",
    "hrtf",
    "webxr",
    "web-audio",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
